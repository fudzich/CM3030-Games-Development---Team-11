      float3 tmp_es = mul((float3x3)uniform_b, tmp_er);\n\t\t\t    float3 tmp_et
      = tmp_eo + tmp_es;\n\t\t\t    float3 tmp_eu = mul((float3x3)uniform_a, tmp_et);\n\t\t\t   
