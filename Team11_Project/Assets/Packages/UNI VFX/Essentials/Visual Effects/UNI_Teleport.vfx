      * uniform_d;\n\t\t    float tmp_dq = tmp_cs[2];\n\t\t    float tmp_dr = tmp_dq
      * uniform_e;\n\t\t    float tmp_ds = tmp_dp - tmp_dr;\n\t\t    float tmp_dt
      = tmp_dq * uniform_f;\n\t\t    float tmp_du = tmp_cs[0];\n\t\t    float tmp_dv
      = tmp_du * uniform_d;\n\t\t    float tmp_dw = tmp_dt - tmp_dv;\n\t\t    float
      tmp_dx = tmp_du * uniform_e;\n\t\t    float tmp_dy = tmp_do * uniform_f;\n\t\t   
      float tmp_dz = tmp_dx - tmp_dy;\n\t\t    float3 tmp_ea = float3(tmp_ds, tmp_dw,
