      tmp_ep);\n\t\t    float3 tmp_er = float3(0, 1, 0) * tmp_eq;\n\t\t    float3
      tmp_es = mul((float3x3)uniform_b, tmp_er);\n\t\t    float3 tmp_et = tmp_eo
