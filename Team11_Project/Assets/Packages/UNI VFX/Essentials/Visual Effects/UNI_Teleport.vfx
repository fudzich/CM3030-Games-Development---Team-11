      = asfloat(attributeBuffer.Load3((index * 0x8 + 0x4) << 2));\n\t\tattributes.mass
      = (float)1;\n\t\tattributes.alive = (attributeBuffer.Load((index * 0x8 + 0x7)
      << 2));\n\t\t\n\r\n\t\t\r\n#if VFX_USE_OLDPOSITION_CURRENT\r\n\t\tattributes.oldPosition
      = attributes.position;\r\n#endif\r\n#if HAS_STRIPS\r\n        const StripData
      stripData = GetStripDataFromParticleIndex(index, PARTICLE_PER_STRIP_COUNT);\r\n       
      InitStripAttributes(index, attributes, stripData);\r\n#endif\r\n\t\t\r\n\t\tAttributeFromCurve_48A85E4B(
      /*inout */attributes.color, attributes.age, attributes.lifetime, Color_a);\n\t\t{\n\t\t   
      ConformToSphere( /*inout */attributes.velocity, attributes.position, attributes.mass,
      float3(0, 0, 0), (float)0.800000012, (float)10, (float)20, (float)0.100000001,
      (float)40, deltaTime_b);\n\t\t}\n\t\t{\n\t\t    float3 tmp_bi = mul(uniform_b,
      float4(attributes.position, 1.0)).xyz;\n\t\t    float3 tmp_bj = tmp_bi - uniform_c;\n\t\t   
      float3 tmp_bl = tmp_bj * tmp_bj;\n\t\t    float tmp_bm = tmp_bl[2];\n\t\t   
      float tmp_bn = tmp_bl[1];\n\t\t    float tmp_bo = tmp_bm + tmp_bn;\n\t\t   
      float tmp_bp = tmp_bl[0];\n\t\t    float tmp_bq = tmp_bo + tmp_bp;\n\t\t   
      float tmp_bs = pow(tmp_bq, (float)0.5);\n\t\t    float tmp_bt = (float)1 /
      tmp_bs;\n\t\t    float3 tmp_bu = float3(tmp_bt, tmp_bt, tmp_bt);\n\t\t    float3
      tmp_bv = tmp_bj * tmp_bu;\n\t\t    float tmp_bw = tmp_bv[1];\n\t\t    float
      tmp_bx = tmp_bw * uniform_d;\n\t\t    float tmp_by = tmp_bv[2];\n\t\t    float
      tmp_bz = tmp_by * uniform_e;\n\t\t    float tmp_ca = tmp_bx - tmp_bz;\n\t\t   
      float tmp_cb = tmp_by * uniform_f;\n\t\t    float tmp_cc = tmp_bv[0];\n\t\t   
      float tmp_cd = tmp_cc * uniform_d;\n\t\t    float tmp_ce = tmp_cb - tmp_cd;\n\t\t   
      float tmp_cf = tmp_cc * uniform_e;\n\t\t    float tmp_cg = tmp_bw * uniform_f;\n\t\t   
      float tmp_ch = tmp_cf - tmp_cg;\n\t\t    float3 tmp_ci = float3(tmp_ca, tmp_ce,
      tmp_ch);\n\t\t    float3 tmp_cj = tmp_ci * tmp_ci;\n\t\t    float tmp_ck =
      tmp_cj[2];\n\t\t    float tmp_cl = tmp_cj[1];\n\t\t    float tmp_cm = tmp_ck
      + tmp_cl;\n\t\t    float tmp_cn = tmp_cj[0];\n\t\t    float tmp_co = tmp_cm
      + tmp_cn;\n\t\t    float tmp_cp = pow(tmp_co, (float)0.5);\n\t\t    float tmp_cq
      = (float)1 / tmp_cp;\n\t\t    float3 tmp_cr = float3(tmp_cq, tmp_cq, tmp_cq);\n\t\t   
      float3 tmp_cs = tmp_ci * tmp_cr;\n\t\t    float3 tmp_ct = tmp_bj * uniform_h;\n\t\t   
      float tmp_cu = tmp_ct[2];\n\t\t    float tmp_cv = tmp_ct[1];\n\t\t    float
      tmp_cw = tmp_cu + tmp_cv;\n\t\t    float tmp_cx = tmp_ct[0];\n\t\t    float
      tmp_cy = tmp_cw + tmp_cx;\n\t\t    float3 tmp_cz = float3(tmp_cy, tmp_cy, tmp_cy);\n\t\t   
      float3 tmp_db = tmp_cz * float3(0, 1, 0);\n\t\t    float3 tmp_dc = mul(uniform_b,
      float4(tmp_db, 1.0)).xyz;\n\t\t    float3 tmp_dd = tmp_bj - tmp_dc;\n\t\t   
      float3 tmp_de = tmp_dd * tmp_dd;\n\t\t    float tmp_df = tmp_de[2];\n\t\t   
      float tmp_dg = tmp_de[1];\n\t\t    float tmp_dh = tmp_df + tmp_dg;\n\t\t   
      float tmp_di = tmp_de[0];\n\t\t    float tmp_dj = tmp_dh + tmp_di;\n\t\t   
      float tmp_dk = pow(tmp_dj, (float)0.5);\n\t\t    float tmp_dl = SampleCurve(uniform_g,tmp_dk);\n\t\t   
      float3 tmp_dm = float3(tmp_dl, tmp_dl, tmp_dl);\n\t\t    float3 tmp_dn = tmp_cs
