      VFX_LOCAL_SPACE 1\n\t\t#include \"Packages/com.unity.visualeffectgraph/Shaders/RenderPipeline/Legacy/VFXDefines.hlsl\"\n\t\t\n\n\t\tCBUFFER_START(parameters)\n\t\t   
      float4 Scale_a;\n\t\t    float4 Size_b;\n\t\tCBUFFER_END\n\t\t\n\t\tstruct
      Attributes\n\t\t{\n\t\t    float lifetime;\n\t\t    float size;\n\t\t    float
      angleX;\n\t\t    float angleY;\n\t\t    float angleZ;\n\t\t    float3 position;\n\t\t   
      float age;\n\t\t    float3 color;\n\t\t    float alpha;\n\t\t    bool alive;\n\t\t   
      float3 axisX;\n\t\t    float3 axisY;\n\t\t    float3 axisZ;\n\t\t    float
      pivotX;\n\t\t    float pivotY;\n\t\t    float pivotZ;\n\t\t    float scaleX;\n\t\t   
      float scaleY;\n\t\t    float scaleZ;\n\t\t};\n\t\t\n\t\tstruct SourceAttributes\n\t\t{\n\t\t};\n\t\t\n\t\tTexture2D
