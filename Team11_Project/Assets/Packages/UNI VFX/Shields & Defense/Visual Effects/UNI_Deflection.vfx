      * 0x1 + 0x30) << 2));\n\t\t\t\t\t\tattributes.position = float3(0, 0, 0);\n\t\t\t\t\t\tattributes.color
      = float3(1, 1, 1);\n\t\t\t\t\t\tattributes.alpha = (float)1;\n\t\t\t\t\t\tattributes.alive
      = (attributeBuffer.Load((index * 0x5 + 0xB) << 2));\n\t\t\t\t\t\tattributes.axisX
