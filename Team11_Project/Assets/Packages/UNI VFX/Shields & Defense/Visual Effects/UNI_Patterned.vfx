      = asfloat(attributeBuffer.Load3((index * 0x8 + 0x0) << 2));\n\t\t\t\t\t\tattributes.lifetime
      = asfloat(attributeBuffer.Load((index * 0x1 + 0x5A000) << 2));\n\t\t\t\t\t\tattributes.size
