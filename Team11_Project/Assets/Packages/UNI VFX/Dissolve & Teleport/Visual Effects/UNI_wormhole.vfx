      SampleMode:OverLife Mode:PerComponent ColorMode:ColorAndAlpha channels:XY */\n\t\t\t{\n\t\t\t   
      float t = age / lifetime;\n\t\t\t    float2 value = 0.0f;\n\t\t\t    value[0]
      = SampleCurve(Scale_x, t);\n\t\t\t    value[1] = SampleCurve(Scale_y, t);\n\t\t\t   
      scaleX *= value.x;\n\t\t\t    scaleY *= value.y;\n\t\t\t}\n\t\t\t\n\n\t\t\t\n\t\t\tstruct
      vs_input\n\t\t\t{\n\t\t\t\tfloat3 pos : POSITION;\n\t\t\t\tfloat2 uv : TEXCOORD0;\n\t\t\t   
