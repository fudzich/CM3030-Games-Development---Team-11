      = (attributeBuffer.Load((index * 0x2 + 0x19) << 2));\n\t\t\n\r\n\t\tif (attributes.alive)\r\n\t\t{\r\n\t\t\tattributes.lifetime
      = asfloat(attributeBuffer.Load((index * 0x1 + 0x0) << 2));\n\t\t\tattributes.position
      = asfloat(attributeBuffer.Load3((index * 0x4 + 0x8) << 2));\n\t\t\tattributes.age
      = asfloat(attributeBuffer.Load((index * 0x2 + 0x18) << 2));\n\t\t\t\n\r\n\r\n//
      Initialize built-in needed attributes\r\n#if VFX_USE_OLDPOSITION_CURRENT\r\n\t\t\tattributes.oldPosition
