      size3 = float3(attributes.size,attributes.size,attributes.size);\n\t\t\t\t\t\t#if
      VFX_USE_SCALEX_CURRENT\n\t\t\t\t\t\tsize3.x *= attributes.scaleX;\n\t\t\t\t\t\t#endif\n\t\t\t\t\t\t#if
