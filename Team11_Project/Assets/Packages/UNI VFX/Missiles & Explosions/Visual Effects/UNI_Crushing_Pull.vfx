      * 0x2 + 0x140) << 2,uint(attributes.alive));\n\t\tattributeBuffer.Store((index
      * 0x2 + 0x141) << 2,asuint(attributes.age));\n\t\t\n\r\n#if VFX_HAS_INDIRECT_DRAW\r\n       
      uint indirectIndex = indirectBuffer.IncrementCounter();\r\n\t\tindirectBuffer[indirectIndex]
      = index;\r\n#endif\r\n#endif\r\n\t}\r\n}\r\n"
  - compute: 0
    name: '[Spikes]Output Particle Mesh'
