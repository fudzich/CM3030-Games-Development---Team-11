      \n\r\n        }\r\n    }\r\n}\r\n"
  - compute: 0
    name: '[Hit Sphere (1)]Output Particle Mesh'
    source: "Shader \"Hidden/VFX/UNI_Crushing_Pull/Hit Sphere (1)/Output Particle
      Mesh\"\n{\r\n\tSubShader\r\n\t{\t\r\n\t\tCull Off\r\n\t\t\r\n\t\tTags { \"Queue\"=\"Transparent\"
