      float tmp_cv = (float)1 / tmp_cu;\n\t\t    float3 tmp_cw = float3(tmp_cv, tmp_cv,
      tmp_cv);\n\t\t    float3 tmp_cx = tmp_cn * tmp_cw;\n\t\t    float3 tmp_cy =
