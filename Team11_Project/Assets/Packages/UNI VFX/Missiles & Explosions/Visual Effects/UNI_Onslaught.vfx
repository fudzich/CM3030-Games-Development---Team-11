      = tmp_cy[0];\n\t\t    float tmp_dd = tmp_db + tmp_dc;\n\t\t    float3 tmp_de
      = float3(tmp_dd, tmp_dd, tmp_dd);\n\t\t    float3 tmp_dg = tmp_de * float3(0,
      1, 0);\n\t\t    float3 tmp_dh = mul(uniform_d, float4(tmp_dg, 1.0)).xyz;\n\t\t   
      float3 tmp_di = tmp_bo - tmp_dh;\n\t\t    float3 tmp_dj = tmp_di * tmp_di;\n\t\t   
