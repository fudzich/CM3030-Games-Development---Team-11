      USE_DEAD_LIST_COUNT 1\n\t\t#define VFX_PRIMITIVE_QUAD 1\n\t\t\n\t\t\n\t\t#define
      VFX_LOCAL_SPACE 1\n\t\t#include \"Packages/com.unity.visualeffectgraph/Shaders/RenderPipeline/Legacy/VFXDefines.hlsl\"\n\t\t\n\n\t\tCBUFFER_START(parameters)\n\t\t   
      float4 Size_b;\n\t\t    float4 uniform_a;\n\t\t    float Color_c;\n\t\t   
      uint3 PADDING_0;\n\t\tCBUFFER_END\n\t\t\n\t\tstruct Attributes\n\t\t{\n\t\t   
      float lifetime;\n\t\t    float texIndex;\n\t\t    float angleX;\n\t\t    float
      angleY;\n\t\t    float angleZ;\n\t\t    float size;\n\t\t    float3 position;\n\t\t   
      float age;\n\t\t    float3 color;\n\t\t    float alpha;\n\t\t    bool alive;\n\t\t   
