      tmp_bn = mul(uniform_d, float4(attributes.position, 1.0)).xyz;\n\t\t    float3
      tmp_bo = tmp_bn - uniform_e;\n\t\t    float3 tmp_bq = tmp_bo * tmp_bo;\n\t\t   
