      tmp_cv, tmp_cv);\n\t\t\t    float3 tmp_cx = tmp_cn * tmp_cw;\n\t\t\t    float3
      tmp_cy = tmp_bo * uniform_j;\n\t\t\t    float tmp_cz = tmp_cy[2];\n\t\t\t   
