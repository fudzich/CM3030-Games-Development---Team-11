      = asfloat(attributeBuffer.Load((index * 0x9 + 0x9) << 2));\n\t\t\t\t\t\tattributes.angleY
      = asfloat(attributeBuffer.Load((index * 0x9 + 0xA) << 2));\n\t\t\t\t\t\tattributes.angleZ
      = asfloat(attributeBuffer.Load((index * 0x9 + 0xB) << 2));\n\t\t\t\t\t\tattributes.pivotX
      = asfloat(attributeBuffer.Load((index * 0x9 + 0xC) << 2));\n\t\t\t\t\t\tattributes.pivotY
      = asfloat(attributeBuffer.Load((index * 0x9 + 0xD) << 2));\n\t\t\t\t\t\tattributes.pivotZ
      = asfloat(attributeBuffer.Load((index * 0x9 + 0xE) << 2));\n\t\t\t\t\t\tattributes.scaleY
      = asfloat(attributeBuffer.Load((index * 0x9 + 0xF) << 2));\n\t\t\t\t\t\tattributes.alpha
      = asfloat(attributeBuffer.Load((index * 0x9 + 0x10) << 2));\n\t\t\t\t\t\tattributes.position
      = asfloat(attributeBuffer.Load3((index * 0x4 + 0x70) << 2));\n\t\t\t\t\t\tattributes.color
