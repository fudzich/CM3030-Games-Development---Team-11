      float3 tmp_cn = float3(tmp_cf, tmp_cj, tmp_cm);\n\t\t    float3 tmp_co = tmp_cn
      * tmp_cn;\n\t\t    float tmp_cp = tmp_co[2];\n\t\t    float tmp_cq = tmp_co[1];\n\t\t   
      float tmp_cr = tmp_cp + tmp_cq;\n\t\t    float tmp_cs = tmp_co[0];\n\t\t   
